# Copie para .env e troque a senha
POSTGRES_DB=spotify
POSTGRES_USER=spotify
POSTGRES_PASSWORD=troque-esta-senha

CORS_ORIGINS=https://alexarnoni.com,https://musica.alexarnoni.com
RATE_LIMIT_PER_MINUTE=60

# Porta do host para a API (o nginx do host faz proxy para ela). Confira se esta livre na VM.
API_PORT=8010
